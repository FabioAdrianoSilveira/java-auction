<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12" alignment="CENTER" xmlns="http://javafx.com/javafx/11.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.openjfx.boilao.AdminUsuariosController">

    <Label text="Painel do Administrador - Usuários" style="-fx-font-size: 20px;" />

    <TextField fx:id="txtCnpj" promptText="CNPJ" />
    <TextField fx:id="txtFazenda" promptText="Nome da Fazenda" />
    <PasswordField fx:id="txtSenha" promptText="Senha" />

    <ComboBox fx:id="cbTipo" promptText="Tipo de usuário" />

    <Button text="Cadastrar Usuário" onAction="#cadastrarUsuario" />

    <Label text="Usuários cadastrados" style="-fx-font-size: 16px;" />

    <TableView fx:id="tabelaUsuarios" prefHeight="250">
        <columns>
            <TableColumn fx:id="colCnpj" text="CNPJ" prefWidth="160" />
            <TableColumn fx:id="colFazenda" text="Fazenda" prefWidth="220" />
            <TableColumn fx:id="colTipo" text="Tipo" prefWidth="120" />
        </columns>
    </TableView>

    <Button text="Deletar Usuário Selecionado" onAction="#deletarUsuario" />

</VBox>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/26.0.1"
           xmlns:fx="http://javafx.com/fxml/1"
           prefWidth="1280.0"
           prefHeight="720.0"
           stylesheets="@css/tabelas.css"
           styleClass="tela-tabelas">

    <VBox alignment="TOP_CENTER"
          prefWidth="1210.0"
          maxWidth="1210.0"
          prefHeight="650.0"
          maxHeight="650.0"
          spacing="15.0"
          styleClass="painel-principal">

        <padding>
            <Insets top="15.0" right="25.0" bottom="25.0" left="25.0"/>
        </padding>

        <StackPane prefHeight="45.0" maxWidth="Infinity">
            <Label text="TABELAS" StackPane.alignment="CENTER" styleClass="titulo-principal"/>
            <Hyperlink fx:id="linkMenu"
                       text="MENU"
                       StackPane.alignment="TOP_RIGHT"
                       styleClass="link-menu"/>
        </StackPane>

        <HBox alignment="TOP_CENTER" spacing="55.0" maxWidth="Infinity">
            <VBox alignment="TOP_LEFT" prefWidth="550.0" maxWidth="550.0" spacing="8.0">
                <Label text="GADOS CADASTRADOS" styleClass="titulo-secao"/>
                <TableView fx:id="tabelaGados"
                           prefWidth="550.0"
                           prefHeight="500.0"
                           styleClass="tabela-dados">
                    <placeholder>
                        <Label text="Nenhum gado cadastrado" styleClass="texto-tabela-vazia"/>
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="colunaGadoId" text="ID" prefWidth="110.0"/>
                        <TableColumn fx:id="colunaTipoGado" text="TIPO DE GADO" prefWidth="150.0"/>
                        <TableColumn fx:id="colunaObservacoes" text="Observações" prefWidth="180.0"/>
                        <TableColumn fx:id="colunaAlterar" text="ALTERAR" prefWidth="105.0"/>
                    </columns>
                </TableView>
            </VBox>

            <VBox alignment="TOP_RIGHT" prefWidth="510.0" maxWidth="510.0" spacing="8.0">
                <Label text="LEILÕES"
                       maxWidth="Infinity"
                       alignment="CENTER_RIGHT"
                       styleClass="titulo-secao"/>
                <TableView fx:id="tabelaLeiloes"
                           prefWidth="510.0"
                           prefHeight="500.0"
                           styleClass="tabela-dados">
                    <placeholder>
                        <Label text="Nenhum leilão cadastrado" styleClass="texto-tabela-vazia"/>
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="colunaLeilaoId" text="ID" prefWidth="52.0"/>
                        <TableColumn fx:id="colunaLeilaoTipoGado" text="TIPO DE&#10;GADO" prefWidth="85.0"/>
                        <TableColumn fx:id="colunaLanceMinimo" text="Lance&#10;Mínimo" prefWidth="80.0"/>
                        <TableColumn fx:id="colunaSeuLance" text="Seu&#10;lance" prefWidth="80.0"/>
                        <TableColumn fx:id="colunaMaiorLance" text="Maior&#10;Lance" prefWidth="90.0"/>
                        <TableColumn fx:id="colunaSituacao" text="Situação:" prefWidth="115.0"/>
                    </columns>
                </TableView>
            </VBox>
        </HBox>
    </VBox>
</StackPane>

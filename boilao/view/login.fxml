<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/26.0.1"
           xmlns:fx="http://javafx.com/fxml/1"
           prefWidth="1280.0"
           prefHeight="720.0"
           stylesheets="@css/login.css"
           styleClass="tela-login">

    <VBox alignment="TOP_CENTER"
          prefWidth="470.0"
          maxWidth="470.0"
          prefHeight="610.0"
          maxHeight="610.0"
          spacing="0"
          styleClass="painel-login">

        <padding>
            <Insets top="20.0" right="65.0" bottom="20.0" left="65.0"/>
        </padding>

        <Label text="LOGIN" styleClass="titulo-login"/>
        <Region prefHeight="70.0"/>

        <VBox maxWidth="340.0" prefWidth="340.0" spacing="8.0">
            <Label text="CNPJ" styleClass="rotulo-campo"/>

            <TextField fx:id="campoCnpj"
                       prefHeight="48.0"
                       maxWidth="340.0"
                       styleClass="campo-login"/>

            <Region prefHeight="13.0"/>

            <Label text="Senha:" styleClass="rotulo-campo"/>

            <PasswordField fx:id="campoSenha"
                           prefHeight="48.0"
                           maxWidth="340.0"
                           styleClass="campo-login"/>

            <Hyperlink fx:id="linkMudarSenha"
                       text="Mudar senha"
                       maxWidth="Infinity"
                       alignment="CENTER_RIGHT"
                       styleClass="link-login"/>
        </VBox>

        <Region prefHeight="20.0"/>

        <Button fx:id="botaoEntrar"
                text="ENTRAR"
                styleClass="botao-entrar"/>

        <Region VBox.vgrow="ALWAYS"/>

        <Hyperlink fx:id="linkAdministradorLogin"
                   text="Administrador login"
                   maxWidth="Infinity"
                   alignment="CENTER_RIGHT"
                   styleClass="link-administrador"/>
    </VBox>
</StackPane>

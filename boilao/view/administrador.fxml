<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/26.0.1"
           xmlns:fx="http://javafx.com/fxml/1"
           prefWidth="1280.0"
           prefHeight="720.0"
           stylesheets="@css/administrador.css"
           styleClass="tela-administrador">

    <VBox alignment="TOP_CENTER"
          prefWidth="550.0"
          maxWidth="550.0"
          prefHeight="610.0"
          maxHeight="610.0"
          spacing="0"
          styleClass="painel-administrador">

        <padding>
            <Insets top="15.0" right="40.0" bottom="30.0" left="40.0"/>
        </padding>

        <Hyperlink fx:id="linkLogout"
                   text="Logout"
                   maxWidth="Infinity"
                   alignment="CENTER_RIGHT"
                   styleClass="link-logout"/>

        <Label text="Bem-vindo ao Boilão"
               maxWidth="Infinity"
               alignment="CENTER"
               styleClass="titulo-administrador"/>

        <Region prefHeight="28.0"/>

        <Button fx:id="botaoCadastroUsuario"
                text="Cadastro&#10;de Usuário"
                wrapText="true"
                prefWidth="280.0"
                prefHeight="78.0"
                styleClass="botao-menu"/>

        <Region prefHeight="14.0"/>

        <Button fx:id="botaoCadastroGado"
                text="Cadastro&#10;de Gado"
                wrapText="true"
                prefWidth="280.0"
                prefHeight="78.0"
                styleClass="botao-menu"/>

        <Region prefHeight="14.0"/>

        <Button fx:id="botaoVerTabelas"
                text="Ver leilões&#10;e gados"
                wrapText="true"
                prefWidth="280.0"
                prefHeight="78.0"
                styleClass="botao-menu"/>

        <Region prefHeight="14.0"/>

        <Button fx:id="botaoRecuperarSenha"
                text="Recuperar Senha"
                wrapText="true"
                prefWidth="280.0"
                prefHeight="70.0"
                styleClass="botao-menu"/>
    </VBox>
</StackPane>
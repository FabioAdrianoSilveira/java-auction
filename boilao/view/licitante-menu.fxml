<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/26.0.1"
           xmlns:fx="http://javafx.com/fxml/1"
           prefWidth="1280.0"
           prefHeight="720.0"
           stylesheets="@css/licitante-menu.css"
           styleClass="tela-licitante-menu">

    <VBox alignment="TOP_CENTER"
          prefWidth="550.0"
          maxWidth="550.0"
          prefHeight="490.0"
          maxHeight="490.0"
          spacing="18.0"
          styleClass="painel-menu">

        <padding>
            <Insets top="18.0" right="40.0" bottom="35.0" left="40.0"/>
        </padding>

        <Hyperlink fx:id="linkLogout"
                   text="Logout"
                   maxWidth="Infinity"
                   alignment="CENTER_RIGHT"
                   styleClass="link-logout"/>

        <Label text="Bem-vindo ao Boilão"
               maxWidth="Infinity"
               alignment="CENTER"
               styleClass="titulo-menu"/>

        <Button fx:id="botaoVisualizarLeiloes"
                text="Visualizar&#10;Leilões"
                wrapText="true"
                prefWidth="260.0"
                prefHeight="85.0"
                styleClass="botao-menu"/>

        <Button fx:id="botaoFazerLance"
                text="Fazer Lance"
                prefWidth="260.0"
                prefHeight="75.0"
                styleClass="botao-menu"/>

        <Button fx:id="botaoMudarSenha"
                text="Mudar&#10;Senha"
                wrapText="true"
                prefWidth="260.0"
                prefHeight="85.0"
                styleClass="botao-menu"/>

    </VBox>
</StackPane>
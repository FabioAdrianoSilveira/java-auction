<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/26.0.1"
           xmlns:fx="http://javafx.com/fxml/1"
           prefWidth="1280.0"
           prefHeight="720.0"
           stylesheets="@css/licitante-gados.css"
           styleClass="tela-gados">

    <HBox alignment="TOP_CENTER"
          spacing="40.0"
          prefWidth="1120.0"
          maxWidth="1120.0"
          prefHeight="620.0"
          maxHeight="620.0"
          styleClass="painel-gados">

        <padding>
            <Insets top="25.0" right="25.0" bottom="35.0" left="25.0"/>
        </padding>

        <VBox alignment="TOP_CENTER"
              prefWidth="400.0"
              maxWidth="400.0"
              spacing="28.0">

            <Label text="BEM-VINDO AO BOILÃO"
                   styleClass="titulo-bem-vindo"/>

            <Button fx:id="botaoHistorico"
                    text="Histórico"
                    prefWidth="260.0"
                    prefHeight="85.0"
                    styleClass="botao-lateral"/>

            <Button fx:id="botaoNovoCadastro"
                    text="Novo Cadastro"
                    prefWidth="260.0"
                    prefHeight="75.0"
                    styleClass="botao-lateral"/>
        </VBox>

        <VBox alignment="TOP_CENTER"
              prefWidth="620.0"
              maxWidth="620.0"
              spacing="12.0">

            <Label text="GADOS CADASTRADOS"
                   styleClass="titulo-gados"/>

            <TableView fx:id="tabelaGados"
                       prefWidth="620.0"
                       prefHeight="480.0"
                       styleClass="tabela-dados">

                <placeholder>
                    <Label text="Nenhum gado cadastrado"
                           styleClass="texto-tabela-vazia"/>
                </placeholder>

                <columns>
                    <TableColumn fx:id="colunaId"
                                 text="ID"
                                 prefWidth="150.0"/>
                    <TableColumn fx:id="colunaTipoGado"
                                 text="TIPO DE GADO"
                                 prefWidth="170.0"/>
                    <TableColumn fx:id="colunaObservacoes"
                                 text="Observações"
                                 prefWidth="200.0"/>
                    <TableColumn fx:id="colunaAlterar"
                                 text="ALTERAR"
                                 prefWidth="95.0"/>
                </columns>
            </TableView>
        </VBox>
    </HBox>
</StackPane>
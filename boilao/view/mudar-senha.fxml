<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/26.0.1"
           xmlns:fx="http://javafx.com/fxml/1"
           prefWidth="1280.0"
           prefHeight="720.0"
           stylesheets="@css/mudar-senha.css"
           styleClass="tela-mudar-senha">

    <VBox alignment="TOP_LEFT"
          prefWidth="520.0"
          maxWidth="520.0"
          prefHeight="430.0"
          maxHeight="430.0"
          spacing="0"
          styleClass="painel-mudar-senha">

        <padding>
            <Insets top="28.0" right="48.0" bottom="35.0" left="48.0"/>
        </padding>

        <Label text="Mudar Senha:"
               maxWidth="Infinity"
               alignment="CENTER"
               styleClass="titulo"/>

        <Label text="Nova Senha:" styleClass="rotulo-senha">
            <VBox.margin>
                <Insets top="48.0"/>
            </VBox.margin>
        </Label>

        <PasswordField fx:id="campoNovaSenha"
                       prefHeight="50.0"
                       maxWidth="Infinity"
                       styleClass="campo-senha">
            <VBox.margin>
                <Insets top="14.0"/>
            </VBox.margin>
        </PasswordField>

        <Region prefHeight="28.0"/>

        <Button fx:id="botaoAlterar"
                text="Alterar"
                maxWidth="230.0"
                prefWidth="230.0"
                prefHeight="90.0"
                styleClass="botao-alterar">
            <VBox.margin>
                <Insets left="95.0"/>
            </VBox.margin>
        </Button>

        <Region VBox.vgrow="ALWAYS"/>

        <HBox alignment="CENTER_LEFT">
            <Button fx:id="botaoVoltarMenu"
                    text="VOLTAR"
                    styleClass="botao-voltar"/>
        </HBox>
    </VBox>
</StackPane>
